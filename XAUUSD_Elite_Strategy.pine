//@version=5
strategy("ICT SILVER BULLET STRATEGY", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=2)

ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
atr = ta.atr(14)

fvg_up = high[2] < low[0]
fvg_down = low[2] > high[0]

trend_up = ema50 > ema200
trend_down = ema50 < ema200

buy_signal = fvg_up and trend_up and close > open
sell_signal = fvg_down and trend_down and close < open

buy_sl = low - (atr * 1.5)
buy_tp = high + (atr * 2.0)

sell_sl = high + (atr * 1.5)
sell_tp = low - (atr * 2.0)

if buy_signal and not na(buy_sl) and not na(buy_tp)
    strategy.entry("BUY", strategy.long)
    strategy.exit("EXIT_BUY", "BUY", stop=buy_sl, limit=buy_tp)

if sell_signal and not na(sell_sl) and not na(sell_tp)
    strategy.entry("SELL", strategy.short)
    strategy.exit("EXIT_SELL", "SELL", stop=sell_sl, limit=sell_tp)

if hour == 23 and minute == 55
    strategy.close_all()

plot(ema50, color=color.blue, linewidth=2)
plot(ema200, color=color.orange, linewidth=2)

plotshape(buy_signal, style=shape.labelup, location=location.belowbar, color=color.green, size=size.small)
plotshape(sell_signal, style=shape.labeldown, location=location.abovebar, color=color.red, size=size.small)